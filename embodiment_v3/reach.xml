<mujoco model="VBK tabletop reach">
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 0"/>
  <visual><global azimuth="90" elevation="-60"/></visual>
  <default>
    <joint damping="2" armature=".025"/>
    <geom friction=".7 .01 .001" rgba=".35 .5 .7 1"/>
    <position kp="100" kv="10" forcelimited="true" forcerange="-30 30"/>
  </default>
  <worldbody>
    <geom name="table" type="box" pos="-.13 0 -.03" size=".52 .36 .03"
          contype="0" conaffinity="0" rgba=".3 .28 .23 1"/>
    <body name="upper_arm" pos="-.44 0 .15">
      <joint name="shoulder" axis="0 0 1" range="-65 65"/>
      <geom type="capsule" fromto="0 0 0 .23 0 0" size=".026"
            contype="0" conaffinity="0" mass=".45"/>
      <body name="forearm" pos=".23 0 0">
        <joint name="elbow" axis="0 0 1" range="-10 110"/>
        <geom type="capsule" fromto="0 0 0 .23 0 0" size=".021"
              contype="0" conaffinity="0" mass=".3"/>
        <geom name="palm" type="sphere" pos=".23 0 0" size=".035" mass=".15"/>
      </body>
    </body>
    <body name="object" pos=".08 0 .15">
      <joint name="object_slide" type="slide" axis="1 0 0" range="-.12 .12"
             damping="3" armature=".02"/>
      <geom name="target" type="sphere" size=".038" mass=".2" rgba=".9 .4 .22 1"/>
    </body>
  </worldbody>
  <actuator>
    <position name="shoulder_target" joint="shoulder"/>
    <position name="elbow_target" joint="elbow"/>
    <position name="object_target" joint="object_slide" kp="140"/>
  </actuator>
</mujoco>
